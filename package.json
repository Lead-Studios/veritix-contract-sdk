{
  "name": "@veritix/contract-sdk",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript client SDK for the VeriTix Soroban smart contract on the Stellar network",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --testPathPattern='tests/(?!.*\\.integration\\.test\\.ts)' --runInBand --forceExit",
    "test:integration": "jest --config jest.integration.config.ts --runInBand --forceExit",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "docs:generate": "typedoc",
    "docs:serve": "npx http-server docs/api -p 8080",
    "size": "size-limit",
    "playground": "ts-node scripts/playground.ts",
    "type-coverage": "type-coverage --at-least 95 --strict"
  },
  "keywords": [
    "stellar",
    "soroban",
    "smart-contract",
    "sdk",
    "veritix",
    "escrow",
    "payments"
  ],
  "author": "VeriTix Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/veritix/contract-sdk.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12.3.0"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "expect-type": "^1.4.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.1.0",
    "type-coverage": "^2.29.1",
    "typedoc": "^0.26.3"
  }
}